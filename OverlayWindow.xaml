<Window x:Class="FolderJumpTool.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderJumpTool"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <!--
        卡片本体 = 窗口内容，不留 Margin/阴影：
        之前 Border Margin=16 + DropShadow 会让"白卡片"视觉上比窗口框退后十几像素，
        结果悬浮窗明明贴着对话框框定位，看起来却隔着一截"空气"且左缘对不齐。
        现在卡片四周没有透明留白，窗口框即视觉边缘，定位所见即所得。
    -->
    <Border Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="6"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            Padding="6">

        <StackPanel Orientation="Vertical" MinWidth="400" MaxWidth="640">
            <!-- 标题行：左"快速跳转"，右侧可折叠的 Everything 搜索框。
                 未配置 es.exe 时 SearchRow 保持 Collapsed，界面与纯收藏版完全一致；
                 配置后自动展开，输入即切换到搜索结果。 -->
            <Grid Margin="6,2,6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Overlay.Title}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TitleForegroundBrush}"/>
                <Grid x:Name="SearchRow"
                      Grid.Column="1"
                      Margin="14,0,0,0"
                      Visibility="Collapsed">
                    <TextBox x:Name="SearchBox"
                             MinWidth="200"
                             VerticalAlignment="Center"
                             FontSize="13"
                             Padding="7,2"
                             BorderBrush="{DynamicResource CardBorderBrush}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextMainBrush}"
                             CaretBrush="{DynamicResource TextMainBrush}"
                             SelectionBrush="#B5D4F4"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_KeyDown"
                             PreviewMouseLeftButtonDown="SearchBox_MouseDown"/>
                    <TextBlock x:Name="SearchHint"
                               Text="{DynamicResource Overlay.SearchHint}"
                               FontSize="12"
                               Foreground="{DynamicResource InputPlaceholderBrush}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="LocationHint"
                           Grid.Column="1"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource PathForegroundBrush}"/>
            </Grid>

            <!-- 标题区与列表的分隔线，让层级清晰（不占列表滚动高度） -->
            <Rectangle Height="1"
                       Margin="2,0,2,4"
                       Fill="{DynamicResource DividerBrush}"/>

            <ScrollViewer x:Name="ListScroller"
                          MaxHeight="340"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent">
                <ItemsControl x:Name="FavoritesList">
                    <ItemsControl.ItemTemplate>
                        <!-- 单行布局：名称加粗在左，路径灰色同行跟随（超宽截断），
                             避免上下两行把窗口撑成长条形。完整路径放 ToolTip。 -->
                        <DataTemplate>
                            <Button Tag="{Binding Path}"
                                    ToolTip="{Binding Path}"
                                    Click="FavoriteButton_Click"
                                    Loaded="Row_Loaded"
                                    MouseEnter="Row_MouseEnter"
                                    MouseLeave="Row_MouseLeave"
                                    HorizontalContentAlignment="Stretch"
                                    Height="30"
                                    Padding="16,3"
                                    VerticalContentAlignment="Center"
                                    Margin="1,0"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    Style="{DynamicResource FavoriteItemButtonStyle}">
                                <!-- 行内容整体缩放层：RenderTransform 走 GPU 合成、不触发重新布局，
                                     保证 hover 放大丝滑无顿挫（FontSize 动画每帧重排文本会卡）。
                                     放大期间文字临时切灰度抗锯齿，避免 ClearType 在非整数缩放下发糊。 -->
                                <Grid x:Name="RowContent"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="RowScale"
                                                        ScaleX="1"
                                                        ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 文件夹图标（Fluent 造型），hover 行内变主题强调色 -->
                                    <Path x:Name="FolderIcon"
                                          Data="M2,3.5 C2,2.6716 2.6716,2 3.5,2 L6,2 L7.5,4 L12.5,4 C13.3284,4 14,4.6716 14,5.5 L14,12.5 C14,13.3284 13.3284,14 12.5,14 L3.5,14 C2.6716,14 2,13.3284 2,12.5 Z"
                                          Fill="{DynamicResource FolderIconBrush}"
                                          Stretch="Uniform"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NameText"
                                               Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               MaxWidth="170"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextMainBrush}"/>
                                    <TextBlock x:Name="PathText"
                                               Grid.Column="2"
                                               Text="{Binding Path}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PathForegroundBrush}"/>
                                    <!-- 星标收藏：空心 = 未收藏（hover 行时淡入弹出，点击加入收藏夹），
                                         实心 = 已在收藏夹（Row_Loaded 初始化常显）。
                                         字形继承按钮前景色（灰/蓝）；内嵌在行按钮里，
                                         点击先 e.Handled=true 阻断冒泡，避免误触跳转。
                                         路径列 * 已把行填满，星标因此固定在行最右缘。 -->
                                    <Button x:Name="StarButton"
                                            Grid.Column="3"
                                            Tag="{Binding Path}"
                                            ToolTip="{DynamicResource Overlay.AddFav}"
                                            Click="FavoriteStar_Click"
                                            Cursor="Hand"
                                            FocusVisualStyle="{x:Null}"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Opacity="0"
                                            IsHitTestVisible="False"
                                            RenderTransformOrigin="0.5,0.5"
                                            Style="{DynamicResource FavoriteStarButtonStyle}">
                                        <Button.RenderTransform>
                                            <!-- 未收藏淡入时 From=0.85 弹入；叠加在行 RowScale 之上，随行一起放大 -->
                                            <ScaleTransform x:Name="StarScale"
                                                            ScaleX="1"
                                                            ScaleY="1"/>
                                        </Button.RenderTransform>
                                        <TextBlock x:Name="StarGlyph"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Text="&#xE734;"/>
                                    </Button>
                                </Grid>
                            </Button>
                            <!-- hover 放大 / 星标淡入 / 已收藏常显 均由 code-behind 事件驱动
                                 （Row_Loaded / Row_MouseEnter / Row_MouseLeave）：
                                 DataTemplate.Triggers 的动画在本环境不可靠，事件驱动 100% 生效。 -->
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态：候选列表为空时给出提示而不是只剩一张空卡。
                 区分两种来源：普通模式（无收藏/无最近）与搜索模式（无匹配结果）。 -->
            <TextBlock x:Name="EmptyHintFav"
                       Text="{DynamicResource Overlay.EmptyHint}"
                       Visibility="Collapsed"
                       FontSize="12"
                       Foreground="{DynamicResource PathForegroundBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       Margin="10,6"/>
            <TextBlock x:Name="EmptyHintSearch"
                       Text="{DynamicResource Overlay.NoResults}"
                       Visibility="Collapsed"
                       FontSize="12"
                       Foreground="{DynamicResource PathForegroundBrush}"
                       TextAlignment="Center"
                       Margin="10,8"/>
        </StackPanel>
    </Border>
</Window>
