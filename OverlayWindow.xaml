<Window x:Class="FolderJumpTool.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderJumpTool"
        Title="FolderJumpTool"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 行图标：Windows 原生 Shell 图标（目录=文件夹图标，文件=按扩展名的类型图标），
             由 FavoriteFolder.IsDirectory/Path 懒加载，结果带缓存。 -->
        <local:ShellIconConverter x:Key="ShellIconConverter"/>

        <!-- 搜索框内的辅助按钮（清空 ×）：无边框小圆角，hover 给淡蓝底 + 蓝色字形 -->
        <Style x:Key="SearchActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource InputPlaceholderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource FolderIconHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 顶部页签按钮（最近 / 收藏）：扁平文字 chip，选中态（浅蓝底 + 主题蓝字）
             由 code-behind 直接改背景/文字色——字号字重恒定不变，两标签天然对齐，
             不因选中加粗产生字形宽度跳变。无 hover 变色，避免与选中底混淆。 -->
        <!-- 页签按钮：下划线式选中（Win11 风格）。
             选中态由 code-behind 控制（主题蓝文字 + 底部主题色短横线，见 UpdateTabRow），
             这里只负责通用外观与 hover 反馈（淡底）；Background 保持透明不与选中态冲突。
             Padding 底部留 0：让下划线能紧贴按钮底边，与下方全宽分隔线贴合。 -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,3,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        卡片本体：分层窗口（AllowsTransparency）内自绘圆角卡片。
        Solid：CardBackgroundBrush 不透明色（默认观感）。
        Acrylic：ACCENT 亚克力真模糊（SetWindowCompositionAttribute），
                此 Border 背景用半透明 tint 盖在模糊层上保证可读（内容底切直角，
                ACCENT 模糊为矩形，直角能避免圆角外的模糊 halo）。
        背景/描边由 ApplyMaterialNow 按材质切换（x:Name=CardBorder）。
    -->
    <Border x:Name="CardBorder"
            Padding="6"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{DynamicResource CardBorderBrush}"
            Background="{DynamicResource CardBackgroundBrush}"
            MouseEnter="Card_MouseEnter"
            MouseLeave="Card_MouseLeave">

        <!-- 固定宽度：宽度是"容器属性"，不该被内容（路径长短/结果集变化）牵着走。
             之前用 MinWidth=400 + MaxWidth=640 配 SizeToContent，宽度会随
             * 列（路径完整文本）的期望宽度在 400~640 间跳动——搜索时每敲一个
             字符都可能突变。改为固定宽度后彻底稳定（高度仍随结果条数自适应）。
             506 + Border 的 Padding 6×2 + 描边 1×2 = 卡片总宽 520。 -->
        <StackPanel Orientation="Vertical" Width="506">
            <!-- 标题行：左"快速跳转"，右侧候选数提示（搜索模式下自动隐藏）。
                 最右的 × 是"手动退出"出口：平时完全透明不可点，
                 hover 卡片任意处才淡入——用于误判窗口/悬浮窗没正常消失时
                 手动停用（点 × 后该对话框不再弹悬浮窗，直到它关闭自动恢复）。 -->
            <Grid Margin="6,2,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Overlay.Title}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TitleForegroundBrush}"/>
                <TextBlock x:Name="LocationHint"
                           Grid.Column="1"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Margin="0,0,6,0"
                           Foreground="{DynamicResource PathForegroundBrush}"/>
                <!-- 手动关闭按钮：Opacity 0 + 不可命中（hover 卡片淡入后可点），
                     样式复用搜索辅助按钮（无边框小圆角、hover 淡蓝底 + 蓝字形）。 -->
                <Button x:Name="DismissButton"
                        Grid.Column="2"
                        Style="{StaticResource SearchActionButtonStyle}"
                        ToolTip="{DynamicResource Overlay.Dismiss}"
                        Click="Dismiss_Click"
                        Opacity="0"
                        IsHitTestVisible="False"
                        VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="9"
                               Text="&#xE711;"/>
                </Button>
            </Grid>

            <!-- 搜索行：整行宽度的扁平搜索条（未配置 es.exe 时整行折叠，界面与纯收藏版一致）。
                 结构：浅灰底圆角容器 = 放大镜图标 + 无边框输入框 + 清空按钮；
                 聚焦时容器描边变主题蓝（code-behind 监听键盘焦点切换）。 -->
            <Grid x:Name="SearchRow"
                  Margin="6,6,6,0"
                  Visibility="Collapsed">
                <Border x:Name="SearchFrame"
                        Height="26"
                        CornerRadius="4"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 放大镜（占位不挡输入） -->
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource InputPlaceholderBrush}"
                                   Margin="8,0,5,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <!-- 输入区：无边框无背景的裸文本框；占位提示与文字同格叠放 -->
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4,0,2,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="12"
                                     CaretBrush="{DynamicResource TextMainBrush}"
                                     Foreground="{DynamicResource TextMainBrush}"
                                     SelectionBrush="{DynamicResource TextSelectionBrush}"
                                     TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_KeyDown"
                                     PreviewMouseLeftButtonDown="SearchBox_MouseDown"
                                     GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                                     LostKeyboardFocus="SearchBox_LostKeyboardFocus"/>
                            <TextBlock x:Name="SearchHint"
                                       Text="{DynamicResource Overlay.SearchHint}"
                                       FontSize="12"
                                       Foreground="{DynamicResource InputPlaceholderBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </Grid>

                        <!-- 清空按钮：有字才出现，点一下回到收藏列表 -->
                        <Button x:Name="ClearButton"
                                Grid.Column="2"
                                Visibility="Collapsed"
                                Margin="2,0,5,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SearchActionButtonStyle}"
                                ToolTip="{DynamicResource Overlay.ClearSearch}"
                                Click="SearchClear_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="9"
                                       Text="&#xE894;"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- 页签行：候选模式显示"最近 / 收藏 / 历史"来源页。
                 最近是主视图（默认选中，即老版"资源管理器窗口 + 最近使用"），
                 收藏是附加页放在后面；历史页列出自己记录的浏览历史（关掉的文件夹也能找回），
                 由托盘"浏览历史▸显示历史页签"开关控制，无历史时整页隐藏。
                 搜索模式整行隐藏——搜索结果独占列表。
                 选中态 = 主题蓝文字 + 底部短横线（下划线式），由 code-behind 更新；
                 横线贴按钮底边、紧邻下方全宽分隔线，形成 Win11 标签页的观感。 -->
            <StackPanel x:Name="TabRow"
                        Orientation="Horizontal"
                        Margin="4,6,4,0">
                <Button x:Name="TabRecentButton"
                        Style="{StaticResource TabButtonStyle}"
                        Click="Tab_Click"
                        Tag="Recent">
                    <Grid>
                        <TextBlock x:Name="TabRecentText"
                                   FontSize="12"
                                   Margin="0,0,0,4"
                                   VerticalAlignment="Center"
                                   Text="{DynamicResource Overlay.TabRecent}"/>
                        <Rectangle x:Name="TabRecentUnderline"
                                   Height="2"
                                   VerticalAlignment="Bottom"
                                   RadiusX="1"
                                   RadiusY="1"
                                   Visibility="Collapsed"
                                   Fill="{DynamicResource FolderIconHoverBrush}"/>
                    </Grid>
                </Button>
                <Button x:Name="TabFavButton"
                        Style="{StaticResource TabButtonStyle}"
                        Margin="4,0,0,0"
                        Click="Tab_Click"
                        Tag="Favorites">
                    <Grid>
                        <TextBlock x:Name="TabFavText"
                                   FontSize="12"
                                   Margin="0,0,0,4"
                                   VerticalAlignment="Center"
                                   Text="{DynamicResource Overlay.TabFavorites}"/>
                        <Rectangle x:Name="TabFavUnderline"
                                   Height="2"
                                   VerticalAlignment="Bottom"
                                   RadiusX="1"
                                   RadiusY="1"
                                   Visibility="Collapsed"
                                   Fill="{DynamicResource FolderIconHoverBrush}"/>
                    </Grid>
                </Button>
                <Button x:Name="TabHistoryButton"
                        Style="{StaticResource TabButtonStyle}"
                        Margin="4,0,0,0"
                        Click="Tab_Click"
                        Tag="History"
                        Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="TabHistoryText"
                                   FontSize="12"
                                   Margin="0,0,0,4"
                                   VerticalAlignment="Center"
                                   Text="{DynamicResource Overlay.TabHistory}"/>
                        <Rectangle x:Name="TabHistoryUnderline"
                                   Height="2"
                                   VerticalAlignment="Bottom"
                                   RadiusX="1"
                                   RadiusY="1"
                                   Visibility="Collapsed"
                                   Fill="{DynamicResource FolderIconHoverBrush}"/>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- 标题区/搜索条与列表的分隔线，让层级清晰（不占列表滚动高度）。
                 上边距收紧到 2：页签的选中下划线就在它正上方，两者贴合。 -->
            <Rectangle Height="1"
                       Margin="2,2,2,4"
                       Fill="{DynamicResource DividerBrush}"/>

            <ScrollViewer x:Name="ListScroller"
                          MaxHeight="240"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent">
                <ItemsControl x:Name="FavoritesList">
                    <ItemsControl.ItemTemplate>
                        <!-- 单行布局：名称在左（默认常规字重，hover 加粗），父目录灰色同行跟随
                             （超宽截断），避免上下两行把窗口撑成长条形。完整路径放 ToolTip。 -->
                        <DataTemplate>
                            <Button Tag="{Binding Path}"
                                    ToolTip="{Binding Path}"
                                    Click="FavoriteButton_Click"
                                    Loaded="Row_Loaded"
                                    MouseEnter="Row_MouseEnter"
                                    MouseLeave="Row_MouseLeave"
                                    HorizontalContentAlignment="Stretch"
                                    Height="30"
                                    Padding="8,3"
                                    VerticalContentAlignment="Center"
                                    Margin="1,0"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    Style="{DynamicResource FavoriteItemButtonStyle}">
                                <!-- hover 反馈不做缩放动画（ScaleTransform 放大需大内边距防溢出，
                                     且非整数缩放对文字有渲染损耗）；改用文字加粗 + 图标变色，
                                     由 code-behind 事件驱动（Row_Loaded / Row_MouseEnter / Row_MouseLeave）。 -->
                                <Grid x:Name="RowContent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Windows 原生图标（ShellIconConverter）：目录=系统文件夹图标，
                                         文件=按扩展名归类的类型图标，肉眼即可区分文件夹/图片/文档/压缩包等 -->
                                    <Image Source="{Binding Converter={StaticResource ShellIconConverter}}"
                                           Width="16"
                                           Height="16"
                                           Stretch="Uniform"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                    <!-- 名称列：外层 Grid 负责"宽度恒定"——hover 时 NameText
                                         变加粗会变宽，而本列是 Auto 宽度，会连带把后面的
                                         路径/星标往右挤一下（移开再还原，来回抖）。
                                         幽灵文本（同文案 + Bold + Hidden）不绘制但参与测量，
                                         列宽恒等于"加粗后"的宽度 → 加粗反馈保留、零位移。 -->
                                    <Grid Grid.Column="1"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center">
                                        <TextBlock x:Name="NameText"
                                                   Text="{Binding Name}"
                                                   FontWeight="Normal"
                                                   FontSize="13"
                                                   MaxWidth="170"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMainBrush}"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   MaxWidth="170"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="Hidden"/>
                                    </Grid>
                                    <!-- 路径列：只显示"父目录"。
                                         左侧名称列已有末段（目录名/文件名），右侧若显示
                                         完整路径就是重复（路径必然以名称结尾）；只显示父目录
                                         两列正好互补成完整路径，且路径更短、更少触发省略。
                                         例：FolderJumpTool | D:\Code\Local -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ParentPath}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PathForegroundBrush}"/>
                                    <!-- 星标收藏：空心 = 未收藏（hover 行时淡入弹出，点击加入收藏夹），
                                         实心 = 已在收藏夹（Row_Loaded 初始化常显）。
                                         字形继承按钮前景色（灰/蓝）；内嵌在行按钮里，
                                         点击先 e.Handled=true 阻断冒泡，避免误触跳转。
                                         路径列 * 已把行填满，星标因此固定在行最右缘。 -->
                                    <Button x:Name="StarButton"
                                            Grid.Column="3"
                                            Tag="{Binding Path}"
                                            ToolTip="{DynamicResource Overlay.AddFav}"
                                            Click="FavoriteStar_Click"
                                            Cursor="Hand"
                                            FocusVisualStyle="{x:Null}"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Opacity="0"
                                            IsHitTestVisible="False"
                                            RenderTransformOrigin="0.5,0.5"
                                            Style="{DynamicResource FavoriteStarButtonStyle}">
                                        <Button.RenderTransform>
                                            <!-- 未收藏淡入时 From=0.85 弹入（仅星标自身缩放，行内文字不缩放） -->
                                            <ScaleTransform x:Name="StarScale"
                                                            ScaleX="1"
                                                            ScaleY="1"/>
                                        </Button.RenderTransform>
                                        <TextBlock x:Name="StarGlyph"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Text="&#xE734;"/>
                                    </Button>
                                </Grid>
                            </Button>
                            <!-- hover 加粗 / 星标淡入 / 已收藏常显 均由 code-behind 事件驱动
                                 （Row_Loaded / Row_MouseEnter / Row_MouseLeave）：
                                 DataTemplate.Triggers 的动画在本环境不可靠，事件驱动 100% 生效。 -->
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态：候选列表为空时给出提示而不是只剩一张空卡。
                 区分两种来源：普通模式（无收藏/无最近）与搜索模式（无匹配结果）。 -->
            <TextBlock x:Name="EmptyHintFav"
                       Text="{DynamicResource Overlay.EmptyHint}"
                       Visibility="Collapsed"
                       FontSize="12"
                       Foreground="{DynamicResource PathForegroundBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       Margin="10,6"/>
            <TextBlock x:Name="EmptyHintSearch"
                       Text="{DynamicResource Overlay.NoResults}"
                       Visibility="Collapsed"
                       FontSize="12"
                       Foreground="{DynamicResource PathForegroundBrush}"
                       TextAlignment="Center"
                       Margin="10,8"/>
        </StackPanel>
    </Border>
</Window>
