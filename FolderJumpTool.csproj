<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FolderJumpTool</RootNamespace>
    <AssemblyName>FolderJumpTool</AssemblyName>

    <!-- Release 版本元数据；CI 打 tag 时会用 -p:Version=<tag> 覆盖 -->
    <Version>0.3.0</Version>
    <Product>FolderJumpTool</Product>
    <Description>Folder-jump assistant that docks beside Windows file dialogs.</Description>
    <Authors>Mux6201</Authors>
    <Copyright>Copyright (c) 2026 Mux6201</Copyright>
    <RepositoryType>git</RepositoryType>

    <!--
      如果你需要监听/操作以管理员权限运行的程序弹出的对话框（例如某些安装程序），
      本程序自身也必须以管理员权限运行，否则 UIPI 会挡住跨权限的窗口访问。
      需要的话把下面这行取消注释，并额外提供一个 app.manifest 文件。
    -->
    <!-- <ApplicationManifest>app.manifest</ApplicationManifest> -->

    <!-- 应用图标：嵌入 exe，标题栏/任务栏/资源管理器都从这里取。
         Assets/app.ico 多尺寸（16/24/32/48/64 BMP 帧 + 128/256 PNG 帧），
         28% 大圆角矩形蓝底（#0067C0）+ 白箭头，与托盘/收藏夹窗图标同款造型。
         生成脚本在 obj/icon_gen.py（一次性，不随仓库提交）。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 收藏夹窗标题栏专用图标：暖橙大圆角（与全局 app.ico 同款造型、不同配色），
         作为 Resource 嵌进程序集，XAML 用 pack URI "/Assets/favorites-window.ico" 取。
         生成脚本在 obj/icon_favorites.py（一次性，不随仓库提交）。 -->
    <Resource Include="Assets\favorites-window.ico" />
  </ItemGroup>

</Project>
