<Window x:Class="FolderJumpTool.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Fav.Title}"
        Width="520"
        Height="460"
        MinWidth="440"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CardBackgroundBrush}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 主按钮：实心主题蓝 + 白字（"+ 添加路径"） -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 删除按钮：默认灰，hover 转红 -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="{DynamicResource PathForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ItemPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题行：左侧标题 + 计数，右侧添加路径按钮 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Fav.Title}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMainBrush}"/>
            <TextBlock x:Name="CountText"
                       Grid.Column="1"
                       Margin="8,0,0,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PathForegroundBrush}"/>
            <Button Grid.Column="3"
                    Content="{DynamicResource Fav.AddPath}"
                    Click="AddPath_Click"
                    Style="{StaticResource ActionButtonStyle}"/>
        </Grid>

        <!-- 列表区：收藏行 + 空状态叠加 -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="FavScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent">
                <ItemsControl x:Name="FavList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 行底部分隔线 -->
                                <Rectangle Grid.ColumnSpan="4"
                                           Height="1"
                                           VerticalAlignment="Bottom"
                                           Fill="{DynamicResource DividerBrush}"/>
                                <Path Grid.Column="0"
                                      Data="M2,3.5 C2,2.6716 2.6716,2 3.5,2 L6,2 L7.5,4 L12.5,4 C13.3284,4 14,4.6716 14,5.5 L14,12.5 C14,13.3284 13.3284,14 12.5,14 L3.5,14 C2.6716,14 2,13.3284 2,12.5 Z"
                                      Fill="{DynamicResource FolderIconBrush}"
                                      Stretch="Uniform"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           MaxWidth="180"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMainBrush}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Path}"
                                           FontSize="12"
                                           Margin="10,0,10,0"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PathForegroundBrush}"/>
                                <Button Grid.Column="3"
                                        Tag="{Binding Path}"
                                        ToolTip="{DynamicResource Fav.RemoveTooltip}"
                                        Click="Remove_Click"
                                        Style="{StaticResource DeleteButtonStyle}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Text="&#xE74D;"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint"
                       Text="{DynamicResource Fav.Empty}"
                       Foreground="{DynamicResource PathForegroundBrush}"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
