<Window x:Class="FolderJumpTool.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderJumpTool"
        Title="{DynamicResource Fav.Title}"
        Width="540"
        Height="460"
        MinWidth="440"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CardBackgroundBrush}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 行图标：Windows 原生 Shell 图标（目录=系统文件夹图标，与资源管理器观感一致），
             由 FavoriteFolder.IsDirectory/Path 懒加载，结果带缓存。 -->
        <local:ShellIconConverter x:Key="ShellIconConverter"/>
        <!-- 主按钮：实心主题蓝 + 白字（"+ 添加路径"） -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 行内图标按钮（重命名/删除共用骨架）：默认灰，hover 各自变色 -->
        <Style x:Key="IconButtonBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="{DynamicResource PathForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ItemPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 重命名按钮：hover 变主题蓝 -->
        <Style x:Key="RenameButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IconButtonBaseStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource FolderIconHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ItemPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 删除按钮：默认灰，hover 转红 -->
        <Style x:Key="DeleteButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IconButtonBaseStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ItemPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题行：左侧标题 + 计数，右侧添加路径按钮 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Fav.Title}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMainBrush}"/>
            <TextBlock x:Name="CountText"
                       Grid.Column="1"
                       Margin="8,0,0,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PathForegroundBrush}"/>
            <Button Grid.Column="3"
                    Content="{DynamicResource Fav.AddPath}"
                    Click="AddPath_Click"
                    Style="{StaticResource ActionButtonStyle}"/>
        </Grid>

        <!-- 列表区：收藏行 + 空状态叠加。行支持拖拽排序（按住行拖动，出现蓝线指示插入位） -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="FavScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent">
                <Grid x:Name="ScrollHost" Background="Transparent">
                    <ItemsControl x:Name="FavList" Background="Transparent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="36"
                                      Background="Transparent"
                                      ToolTip="{Binding Path}"
                                      MouseLeftButtonDown="Row_MouseDown"
                                      MouseMove="Row_MouseMove"
                                      MouseUp="Row_MouseUp">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 行底部分隔线 -->
                                    <Rectangle Grid.ColumnSpan="5"
                                               Height="1"
                                               VerticalAlignment="Bottom"
                                               Fill="{DynamicResource DividerBrush}"/>
                                    <!-- 行图标：Windows 原生 Shell 文件夹图标（与资源管理器一致，
                                         桌面/下载/文档等特殊文件夹还会显示各自的专属图标） -->
                                    <Image Grid.Column="0"
                                           Source="{Binding Converter={StaticResource ShellIconConverter}}"
                                           Width="16"
                                           Height="16"
                                           Stretch="Uniform"
                                           Margin="2,0,10,0"
                                           VerticalAlignment="Center"/>
                                    <!-- 名称单元格：展示 TextBlock 与行内编辑 TextBox 叠放切换 -->
                                    <Grid Grid.Column="1">
                                        <TextBlock x:Name="NameText"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   MaxWidth="150"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMainBrush}"
                                                   MouseLeftButtonDown="NameText_MouseDown"/>
                                        <TextBox x:Name="RenameBox"
                                                 Visibility="Collapsed"
                                                 FontSize="13"
                                                 FontWeight="SemiBold"
                                                 MinWidth="150"
                                                 MaxWidth="260"
                                                 Padding="2,1"
                                                 VerticalContentAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 BorderThickness="0,0,1,1"
                                                 BorderBrush="{DynamicResource AccentBrush}"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextMainBrush}"
                                                 CaretBrush="{DynamicResource TextMainBrush}"
                                                 KeyDown="RenameBox_KeyDown"
                                                 LostFocus="RenameBox_LostFocus"/>
                                    </Grid>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Path}"
                                               FontSize="12"
                                               Margin="10,0,10,0"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PathForegroundBrush}"/>
                                    <!-- 重命名（铅笔 E70F） -->
                                    <Button Grid.Column="3"
                                            Tag="{Binding Path}"
                                            ToolTip="{DynamicResource Fav.RenameTooltip}"
                                            Click="Rename_Click"
                                            Margin="0,0,2,0"
                                            Style="{StaticResource RenameButtonStyle}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Text="&#xE70F;"/>
                                    </Button>
                                    <!-- 删除 -->
                                    <Button Grid.Column="4"
                                            Tag="{Binding Path}"
                                            ToolTip="{DynamicResource Fav.RemoveTooltip}"
                                            Click="Remove_Click"
                                            Style="{StaticResource DeleteButtonStyle}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Text="&#xE74D;"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 拖拽排序的插入位置指示线：拖动时可见，纵向定位到目标行边界 -->
                    <Rectangle x:Name="DropLine"
                               Visibility="Collapsed"
                               Height="2"
                               Margin="4,0,4,0"
                               VerticalAlignment="Top"
                               Fill="{DynamicResource AccentBrush}"
                               IsHitTestVisible="False"/>
                </Grid>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint"
                       Text="{DynamicResource Fav.Empty}"
                       Foreground="{DynamicResource PathForegroundBrush}"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
