<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 亮色主题（跟随 Windows 系统亮色，近似 Win11 Acrylic 亮色基调，纯不透明） -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E2E2"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="PathForegroundBrush" Color="#757575"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#F2F7FD"/>
    <SolidColorBrush x:Key="ItemPressedBrush" Color="#E2EDF9"/>
    <SolidColorBrush x:Key="FolderIconBrush" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="FolderIconHoverBrush" Color="#378ADD"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#8C8C8C"/>
    <!-- 细条滚动条（亮色）：thumb 三段色，轨道透明 -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C9C9C9"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="#8A8A8A"/>

    <Style x:Key="FavoriteItemButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ItemHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource ItemPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 细条滚动条（隐式样式，作用于本程序所有 ScrollBar）：
         无上下箭头按钮、轨道透明、thumb 圆角细条。
         thumb 颜色走 DynamicResource，主题热切换时一并刷新。
         当前窗口只有垂直滚动条（HorizontalScrollBarVisibility=Disabled），
         因此模板按垂直布局设计；宽度 7 = thumb 本体 5 + 两侧 1px 留白。 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="7"/>
        <Setter Property="MinWidth" Value="7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Opacity="0"
                                              Focusable="False"
                                              IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False" IsTabStop="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBar"
                                                    CornerRadius="2.5"
                                                    Margin="1,1,1,1"
                                                    MinHeight="24"
                                                    Background="{DynamicResource ScrollBarThumbBrush}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBar" Property="Background"
                                                            Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBar" Property="Background"
                                                            Value="{DynamicResource ScrollBarThumbPressedBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Opacity="0"
                                              Focusable="False"
                                              IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 星标收藏按钮（悬浮窗条目行尾）：默认灰，hover 变主题蓝提示"可收藏"。
         空心/实心字形与"已在收藏夹"状态由条目 DataTrigger 驱动（见 OverlayWindow.xaml）。 -->
    <Style x:Key="FavoriteStarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource PathForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource FolderIconHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 危险操作前景色（收藏夹管理窗口的删除按钮 hover 等） -->
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#C42B1C"/>

    <!-- 主操作按钮三态（收藏夹管理窗口"添加路径"等）：实心主题蓝 + 白字 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#378ADD"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2E7CC8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2669AC"/>

</ResourceDictionary>
