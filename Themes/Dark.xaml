<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 控件样式与明暗无关，抽到共享字典（本字典优先合并，样式内 DynamicResource 引用下面的画刷） -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- 暗色主题（跟随 Windows 系统暗色，近似 Win11 Acrylic 暗色基调，纯不透明） -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#232323"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#333333"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="#9B9B9B"/>
    <SolidColorBrush x:Key="PathForegroundBrush" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#1F3A57"/>
    <SolidColorBrush x:Key="ItemPressedBrush" Color="#2B4C73"/>
    <SolidColorBrush x:Key="FolderIconBrush" Color="#8F98A3"/>
    <SolidColorBrush x:Key="FolderIconHoverBrush" Color="#4CC2FF"/>
    <!-- 键盘上下选中行的高亮底：主题强调色 @ ~18% 透明度（与鼠标 hover 的 ItemHoverBrush
         区分）。颜色在主题里定死，code-behind 只取画刷，不再现算 FromArgb。 -->
    <SolidColorBrush x:Key="NavHighlightBrush" Color="#2E4CC2FF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2E2E2E"/>
    <!-- 亚克力态搜索框底：60% 不透明（99）——与半透明卡片同语言；Solid 用实心版 -->
    <SolidColorBrush x:Key="AcrylicInputBackgroundBrush" Color="#992E2E2E"/>
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#7A7A7A"/>
    <!-- 搜索框内选中文字的高亮底（暗色深蓝，亮色在 Light.xaml 用浅蓝） -->
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#264F78"/>
    <!-- 亚克力内容底：半透明 tint（alpha 35% = 59 深）盖在 ACCENT 模糊层上，
         模糊可见 + 文字尚可读。调透明度只改这一处，WPF 层与 DWM 层自动同步；
         halo/直角问题由"内容底=矩形"解决（见 OverlayWindow.ApplyMaterialNow）。 -->
    <SolidColorBrush x:Key="MaterialAcrylicBrush" Color="#59232323"/>
    <!-- 细条滚动条（暗色）：thumb 三段色，轨道透明 -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#484848"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#5E5E5E"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="#757575"/>

    <!-- 危险操作前景色（收藏夹管理窗口的删除按钮 hover 等） -->
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FF8A80"/>

    <!-- 主操作按钮三态（收藏夹管理窗口"添加路径"等）：实心主题蓝 + 白字 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2E8CE0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#45A2F0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#276FAD"/>

</ResourceDictionary>
